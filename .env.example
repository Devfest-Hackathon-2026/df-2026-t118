# このファイルをコピーして .env を作り、値を入れてください（.env は git に入りません）
#   cp .env.example .env
# 値はチャットツールなどで共有し、GitHub には絶対に書かないこと。
# 新しい環境変数を追加したら、ここにキー名だけ追記してください。

# Gemini API（Google AI Studio で発行したキーを使う場合）
GEMINI_API_KEY=

# Google Cloud（Vertex AI / Cloud Run などを使う場合）
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-northeast1
