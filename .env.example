# このファイルをコピーして .env を作り、値を入れてください（.env は git に入りません）
#   cp .env.example .env
# 値はチャットツールなどで共有し、GitHub には絶対に書かないこと。
# 新しい環境変数を追加したら、ここにキー名だけ追記してください。

# Gemini API（Google AI Studio で発行したキーを使う場合）
GEMINI_API_KEY=

# Google Cloud（Vertex AI / Cloud Run などを使う場合）
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-northeast1

# Firebase クライアント設定（設定すると Firestore / Auth / Storage / Functions に接続、未設定時はローカル保存＋開発サーバー経由で動作）
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=asia-northeast1
