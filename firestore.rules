rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ここに match を書いていないルート直下のコレクションは、クライアントから読み書きできない。
    // config/aiGuard（AI のキルスイッチと上限）と aiUsageDaily/{日付}（全体カウンタ）は
    // それに当たる。Cloud Functions の Admin SDK はルールを経由しないので書き込める

    // ユーザー本人のみ自分の島の状態と本人管理サブコレクションを読み書き可能
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // サーバー（Admin SDK / Cloud Functions）管理のジョブ・検証済みレポート・通知送信キューは
      // 本人のみ読み取り可とし、クライアントからの直接改ざん（write）を禁止する
      match /researchJobs/{jobId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
      match /researchReports/{reportId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
      match /notificationOutbox/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
      match /discoveryCandidates/{candidateId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      // AI 呼び出しの日次カウンタ（イシュー #38）。
      // クライアントから書けると自分の上限をリセットできてしまい、ガードが成立しない。
      // 本人は自分の使用量を読めるだけにする（書き込みは Cloud Functions の Admin SDK のみ）
      match /aiUsage/{dateKey} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      // ユーザーが操作・編集・削除できるサブコレクション（items / bundles / proposals / projects / areas / settings / profileFacts / questions / confirmedSubjects / curatedSources / discoveryFeedback / notificationSubscriptions）
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid
          && !(subcollection in ['researchJobs', 'researchReports', 'notificationOutbox', 'discoveryCandidates', 'aiUsage']);
      }
    }
  }
}
