rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ユーザー本人のみ自分の島の状態とサブコレクション（items / bundles / proposals）を読み書き可能
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
